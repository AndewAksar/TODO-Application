# Docker image produced and published by CI.
# In a real deployment, replace the example tag with the commit SHA.
API_IMAGE=ghcr.io/andewaksar/todo-application-api:replace-with-commit-sha

# PostgreSQL initialization.
POSTGRES_DB=todo
POSTGRES_USER=todo_app
POSTGRES_PASSWORD=replace-with-long-random-password

# Application connection to PostgreSQL inside the Docker network.
# Keep the username, password and database name consistent with the values above.
DATABASE_URL=postgresql+asyncpg://todo_app:replace-with-long-random-password@postgres:5432/todo

# JWT configuration.
JWT_SECRET_KEY=replace-with-long-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=30
